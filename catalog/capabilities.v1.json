      },
      "status": "unsupported",
      "action": "drop",
      "reason": "Kimi Code's Anthropic endpoint has no verified execution contract for these provider-owned declarations. CSSwitch drops only the typed forms and recomputes tool_choice; ordinary Python, Bash, Compute, web_search functions and host.mcp orchestration remain client-owned.",
      "evidence": [
        "desktop/gateway/src/anthropic_compat.rs",
        ".trellis/tasks/08-03-kimi-protocol-compatibility/research/official-provider-capability-matrix.md"
      ],
      "tests": [
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_contract_policy_drops_typed_web_search_and_preserves_client_and_unknown_typed_tools"
      ]
    },
