      "id": "tool.deepseek.unsupported-server-tool-filter",
      "scope": "tool",
      "match": {
        "provider": "deepseek",
        "provider_contract": "deepseek-native",
        "tool_type_family": [
          "web_fetch_*",
          "code_execution_*",
