  "tool_rules": [
    {
      "id": "tool.kimi.web_search.server-tool-filter",
      "scope": "tool",
      "match": {
        "provider": "relay",
        "provider_contract": "kimi-anthropic-relay",
        "tool_type_family": "web_search_*"
      },
      "status": "limited",
      "action": "drop",
      "reason": "Live A/B on the current Science request shape showed that the Science-supplied web_search_20250305 declaration triggers an upstream 429 while the same request succeeds when that typed declaration is removed. CSSwitch temporarily drops only Kimi typed web_search_* declarations and recomputes forced tool_choice; same-named ordinary client tools, Science-local Python/Bash/R/Compute, and host.mcp remain untouched. The same Coding Plan can execute the versioned tool through Claude Code plus an upstream cc-switch passthrough, so this is a request-shape workaround rather than a permanent provider capability verdict. web_search_20250305 is an Anthropic GA versioned schema: CSSwitch neither strips its suffix nor adds guessed beta routing. /coding/v1/search is a separate host-service endpoint and is not evidence for Messages server-tool compatibility.",
      "evidence": [
        "desktop/gateway/src/anthropic_compat.rs",
        ".trellis/tasks/08-03-kimi-protocol-compatibility/research/kimi-first-turn-429-regression-audit.md",
        "test/golden/relay_anthropic.json"
      ],
      "tests": [
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_contract_policy_drops_typed_web_search_and_preserves_client_and_unknown_typed_tools",
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_stream_filter_drops_server_tool_blocks_and_compacts_indexes",
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_stream_filter_rejects_envelope_only_and_nonterminal_server_tool_responses",
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_nonstream_filter_preserves_signed_thinking_and_rejects_unsigned_content",
        "desktop/gateway/src/anthropic_compat.rs::tests::kimi_nonstream_filter_rejects_envelope_only_and_nonterminal_server_tool_responses",
        "test.test_gateway_rust.RustGatewayLoopback.test_relay_kimi_stream_filters_server_tool_blocks"
      ]
    },
    {
      "id": "tool.kimi.unsupported-server-tool-filter",
      "scope": "tool",
      "match": {
        "provider": "relay",
        "provider_contract": "kimi-anthropic-relay",
        "tool_type_family": [
          "web_fetch_*",
          "code_execution_*",
          "mcp_toolset",
          "mcp_servers",
          "tool_search_tool_*",
          "advisor_*"
