# 构建产物
target/
**/target/
dist/
build/

# 运行产物与本地临时文件
*.pyc
__pycache__/
scratchpad/
.seed

# 绝不入库任何密钥
*.env
.env
*secret*
*token*

# macOS 杂物
.DS_Store

# 本机工具的会话配置
.claude/
.superpowers/

# 本机 agent 工具目录,整个不入库。
# .agents/ 里已入库的 rules、context 与 handoffs/README.md 继续跟踪;新增文件要 `git add -f`。
/.agents/
/.codex/
/.kimi-code/

# OpenSpec:跟踪配置、规格、编码规范、总览与任务证据;进行中的变更留在本机
/openspec/*
!/openspec/config.yaml
!/openspec/specs/
!/openspec/conventions/
!/openspec/README.md
!/openspec/ARCHITECTURE.md
!/openspec/evidence/
