.DS_Store

# 本机工具的会话配置
.claude/
.superpowers/

# Trellis:只入库项目知识(规范、工作流定义)。
# 任务目录含调研草稿与逐日 journal,属个人执行痕迹;
# agents/scripts 与 .agents/skills 是 trellis 工具的生成物,由 trellis update 维护。
/.trellis/tasks/
/.trellis/workspace/
/.trellis/agents/
/.trellis/scripts/
/.agents/skills/
/.codex/

# Agent 临时交接是本地执行残留,只跟踪其策略说明
.agents/handoffs/*
!.agents/handoffs/README.md
