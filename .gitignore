# 构建产物
target/
**/target/
dist/
build/

# 运行产物与本地临时文件
*.pyc
__pycache__/
scratchpad/
.seed

# 绝不入库任何密钥
*.env
.env
*secret*
*token*

# macOS 杂物
.DS_Store

# 本机工具的会话配置
.claude/
.superpowers/

# Trellis:只入库项目规范(.trellis/spec/)。
# 其余都是本机执行痕迹或 trellis 工具维护的内容:任务与逐日 journal、工作流定义、
# 配置、版本号与模板哈希、agents/scripts;.agents/skills 同属工具生成物。
/.trellis/*
!/.trellis/spec/
/.agents/skills/
/.codex/

# Agent 临时交接是本地执行残留,只跟踪其策略说明
.agents/handoffs/*
!.agents/handoffs/README.md
