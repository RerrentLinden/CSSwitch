#!/bin/bash
# CSSwitch:启动本地服务并打开控制台。
#
#   ./csswitch          启动(已在跑则只打开控制台)
#   ./csswitch stop     停止
#   ./csswitch status   看一眼当前模式
#
# 服务在前台运行,Ctrl-C 或控制台里的「退出服务」都能停掉它。
set -uo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
STATE="$HOME/.csswitch"
PORT="${CSSWITCH_PORT:-8788}"
CONSOLE="http://127.0.0.1:$PORT"
mkdir -p "$STATE"

running() { curl -sf --max-time 2 "$CONSOLE/control/status" >/dev/null 2>&1; }

case "${1:-start}" in
  stop)
    if running; then
      curl -sf --max-time 5 -X POST "$CONSOLE/control/quit" >/dev/null 2>&1
      echo "已请求退出。"
    else
      echo "服务未在运行。"
    fi
    exit 0
    ;;
  status)
    if running; then
      curl -s --max-time 5 "$CONSOLE/control/status" \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); print("模式:",d["mode_label"],"| 控制台:",d["base_url"],"| Science:","运行中" if d["science"]["running"] else "未运行")'
    else
      echo "服务未在运行。"
    fi
    exit 0
    ;;
  start) ;;
  *) echo "用法:$0 [start|stop|status]" >&2; exit 2 ;;
esac

if running; then
  echo "服务已在运行,打开控制台。"
  open "$CONSOLE/" 2>/dev/null || echo "$CONSOLE/"
  exit 0
fi

# shellcheck source=test/_cargo_path.sh
source "$ROOT/test/_cargo_path.sh"
BIN="$ROOT/desktop/gateway/target/release/csswitch-gateway"
GATEWAY="$ROOT/desktop/gateway"

# 构建门:二进制缺失,或任一源码 / 清单比二进制新,都必须重建后再启动。
# 曾经只在缺失时构建,「改完源码重启」静默等于「继续跑旧版」(2026-08-19 实锤)。
SOURCES=(
  "$GATEWAY/src"
  "$GATEWAY/ui"
  "$GATEWAY/Cargo.toml"
  "$ROOT/catalog/provider-contracts.v1.json"
)
[ -f "$GATEWAY/Cargo.lock" ] && SOURCES+=("$GATEWAY/Cargo.lock")

build_reason=""
if [ ! -x "$BIN" ]; then
  build_reason="首次运行,尚无二进制"
elif [ -n "$(find "${SOURCES[@]}" -newer "$BIN" -print -quit 2>/dev/null)" ]; then
  build_reason="源码比二进制新"
fi

if [ -n "$build_reason" ]; then
  ensure_rust_toolchain_on_path || { echo "找不到 cargo 工具链,无法构建网关" >&2; exit 1; }
  echo "$build_reason,正在构建…"
  if ! cargo build --release --manifest-path "$GATEWAY/Cargo.toml"; then
    echo "构建失败:不启动(也不会回退到旧二进制)。" >&2
    exit 1
  fi
fi

# 控制台在服务就绪后再开,避免打开一个空白页。
( for _ in $(seq 1 50); do
    running && { open "$CONSOLE/" 2>/dev/null || true; break; }
    sleep 0.2
  done ) &

exec "$BIN" serve --port "$PORT"
